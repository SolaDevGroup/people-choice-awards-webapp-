# Copy this file to scripts/.env and fill in the values. scripts/.env is git-ignored.
# These keys are used ONLY by the local import script — never in the browser.

# API-Football key (https://dashboard.api-football.com/register — direct API, not RapidAPI)
API_FOOTBALL_KEY=

# Supabase service-role key: Project Settings → API → "service_role" (secret!)
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_URL=https://laypjrtpnvpubzqwnvnt.supabase.co

# Target World Cup season. 2026 requires a PAID API-Football plan (free = 2022–2024,
# and the script auto-falls back to 2022 on a free key).
WC_SEASON=2026

# Per-run daily call cap. Free plan = 100/day → keep ~95. On a PAID plan raise this
# (e.g. 500) so one run can import all rosters + stats.
MAX_CALLS=95

# Spacing between API calls (ms). Leave as-is — the script AUTO-ADAPTS to the plan's
# per-minute limit (free 10/min → ~6s; paid → fast). Only set to override.
RATE_MS=6500
